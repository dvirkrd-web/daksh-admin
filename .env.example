# DAKSH ONLINE PRINTING — Admin Dashboard configuration
# Copy to ".env.local" and adjust if the backend runs somewhere else.
# This is the ONLY setting the dashboard needs. There are no secrets here:
# the dashboard stores just the admin JWT (from login) in the browser.

# Base URL of the Phase 3 backend API (must include the /api/v1 prefix).
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
